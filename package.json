{
  "private": true,
  "type": "module",
  "scripts": {
    "format": "bun --bun x prettier --write '**/*.{php,md,json}'",
    "lint": "bun run lint:prettier && bun run lint:psalm",
    "lint:prettier": "bun --bun x prettier --check '**/*.{php,md,json}'",
    "lint:psalm": "php ./vendor/bin/psalm --no-cache",
    "prepare": "husky",
    "test": "php ./vendor/bin/phpunit"
  },
  "devDependencies": {
    "@prettier/plugin-php": "^0.24.0",
    "@prettier/plugin-xml": "^3.4.2",
    "husky": "^9.1.7",
    "prettier": "^3.6.2"
  }
}
