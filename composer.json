{
  "name": "averay/twig-extensions",
  "description": "A collection of Twig extensions to improve template authoring.",
  "type": "library",
  "license": "MIT",
  "homepage": "https://github.com/adamaveray/twig-extensions",
  "authors": [
    {
      "name": "Adam Averay",
      "homepage": "https://adamaveray.au/"
    }
  ],
  "autoload": {
    "psr-4": {
      "Averay\\TwigExtensions\\": "src/"
    }
  },
  "autoload-dev": {
    "psr-4": {
      "Averay\\TwigExtensions\\Tests\\": "tests/"
    },
    "files": [
      "node_modules/@averay/codeformat/autoload.php"
    ]
  },
  "require": {
    "php": ">=8.5",
    "ext-intl": "*",
    "averay/html-builder": "^0.4",
    "fakerphp/faker": "^1.24",
    "league/commonmark": "^2.10",
    "psr/container": "^2.0",
    "symfony/asset": "^8.1",
    "symfony/contracts": "^3.7",
    "symfony/mime": "^8.1",
    "symfony/stopwatch": "^8.1",
    "symfony/string": "^8.1",
    "symfony/translation": "^8.1",
    "symfony/twig-bridge": "^8.1",
    "symfony/var-dumper": "^8.1",
    "twig/cache-extra": "^3.28",
    "twig/html-extra": "^3.29",
    "twig/intl-extra": "^3.30",
    "twig/twig": "^v3.30"
  },
  "require-dev": {
    "ext-simplexml": "*",
    "carthage-software/mago": "^1.51",
    "friendsofphp/php-cs-fixer": "^3.95",
    "phpunit/phpunit": "^13.4",
    "roave/security-advisories": "dev-latest",
    "symfony/cache": "^8.1",
    "symfony/finder": "^8.1",
    "symfony/http-foundation": "^8.1",
    "symfony/ux-twig-component": "~3.5"
  },
  "suggest": {
    "symfony/cache": "Required to use Twig Components (^8.1).",
    "symfony/finder": "Required to use Twig Components (^8.1).",
    "symfony/ux-twig-component": "Required to use Twig Components (~3.5)."
  }
}
