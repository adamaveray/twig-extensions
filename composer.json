{
  "name": "averay/twig-extensions",
  "type": "library",
  "license": "MIT",
  "version": "0.3.0",
  "homepage": "https://github.com/adamaveray/twig-extensions",
  "authors": [
    {
      "name": "Adam Averay",
      "homepage": "https://adamaveray.au/"
    }
  ],
  "autoload": {
    "psr-4": {
      "Averay\\TwigExtensions\\": "src/"
    }
  },
  "autoload-dev": {
    "psr-4": {
      "Averay\\TwigExtensions\\Tests\\": "tests/"
    },
    "files": [
      "node_modules/@averay/codeformat/autoload.php"
    ]
  },
  "require": {
    "php": ">=8.5",
    "ext-intl": "*",
    "averay/html-builder": "^0.3",
    "fakerphp/faker": "^1.2",
    "league/commonmark": "^2.8",
    "psr/container": "^2.0",
    "symfony/asset": "^8.0",
    "symfony/contracts": "^3.7",
    "symfony/mime": "^8.0",
    "symfony/stopwatch": "^8.0",
    "symfony/string": "^8.0",
    "symfony/translation": "^8.0",
    "symfony/twig-bridge": "^8.0",
    "symfony/var-dumper": "^8.0",
    "twig/cache-extra": "^3.24",
    "twig/intl-extra": "^3.24",
    "twig/twig": "^v3.24"
  },
  "require-dev": {
    "ext-simplexml": "*",
    "carthage-software/mago": "^1.50",
    "friendsofphp/php-cs-fixer": "^3.95",
    "phpunit/phpunit": "^13.1",
    "roave/security-advisories": "dev-latest",
    "symfony/http-foundation": "^8.0"
  }
}
